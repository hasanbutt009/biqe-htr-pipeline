# BIQE OCR Service - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Google Cloud Project
# ===========================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west4

# ===========================================
# GEMINI MODELS (Optional - defaults shown)
# ===========================================
# Primary model - fast and cost-effective
GEMINI_MODEL_FLASH=gemini-3-flash-preview

# Fallback model - for complex/low-confidence images
GEMINI_MODEL_PRO=gemini-3-pro-preview

# Confidence threshold for Flash-to-Pro routing (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.95

# Temperature for Gemini (0.0 = deterministic, 2.0 = creative)
# 0.0 recommended to prevent hallucination
TEMPERATURE=0.0

# ===========================================
# GCS BUCKETS (Required for GCS-based batch flow)
# ===========================================
# Client uploads images directly to input bucket
GCS_INPUT_BUCKET=your-project-id-htr-input

# Worker stores results in output bucket
GCS_OUTPUT_BUCKET=your-project-id-htr-output

# ===========================================
# PUB/SUB (Optional - defaults shown)
# ===========================================
# PUBSUB_TOPIC=ocr-jobs-topic

# ===========================================
# RATE LIMITING (Adjust when quota increases)
# ===========================================
# Current Gemini 3 Preview quota: 5 RPM
# When Google increases your quota, adjust these:

# API requests per minute (default: 5)
API_RPM_LIMIT=5

# Seconds between API calls per worker (default: 15)
# For 5 RPM:  15 seconds (safe margin)
# For 15 RPM: 5 seconds
# For 60 RPM: 1 second
WORKER_RATE_LIMIT_SECONDS=15.0

# ===========================================
# PARALLEL PROCESSING (For Tier 2+ accounts)
# ===========================================
# With Tier 2, you can process multiple images simultaneously
# Set to 1 for serial processing, increase for parallel
# Recommended: 5 for Tier 2, 10+ for higher tiers
OCR_PARALLEL_WORKERS=5

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO

# ===========================================
# PRODUCTION SERVICE URL
# ===========================================
# After deployment, your service will be available at:
# https://biqe-ocr-service-aqy2r6gija-ez.a.run.app
#
# Test commands:
# curl https://biqe-ocr-service-aqy2r6gija-ez.a.run.app/health
# curl -X POST https://biqe-ocr-service-aqy2r6gija-ez.a.run.app/ocr -F "file=@image.jpg"
